        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.5.2",
      "targets": [
        {
          "bucketAggs": [
            { "field": "probe_received_at", "id": "4", "settings": { "interval": "auto", "min_doc_count": "0" }, "type": "date_histogram" }
          ],
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "webstore-logs" },
          "format": "time_series",
          "metrics": [
            { "field": "probe_e2e_latency_ms", "id": "1", "type": "avg" },
            { "field": "probe_e2e_latency_ms", "id": "2", "settings": { "percents": ["95"] }, "type": "percentiles" },
            { "field": "probe_e2e_latency_ms", "id": "3", "settings": { "percents": ["99"] }, "type": "percentiles" }
          ],
          "query": "eventName.keyword:\"demo.telemetry.pipeline.probe\" AND probe_e2e_latency_ms:[0 TO *]",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "probe_received_at"
        }
      ],
      "title": "Backend-observed latency (avg, p95, p99)",
      "type": "timeseries"
    }
